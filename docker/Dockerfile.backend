FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
# gcc/g++ might be needed for some python packages
# Use tuna mirrors for Debian
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster dependency resolution
# Use tuna mirrors for pip
RUN pip install uv -i https://pypi.tuna.tsinghua.edu.cn/simple

# Copy project definition files
COPY packages/core/pyproject.toml packages/core/README.md /app/packages/core/
COPY packages/backend/pyproject.toml packages/backend/README.md /app/packages/backend/

# Install dependencies
# We use --system flag to install into system python (no venv needed in container)
# Use tuna mirrors for uv pip
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
WORKDIR /app/packages/backend
RUN uv pip install --system -e ../core
RUN uv pip install --system -e .

# Copy packages/backend/app/main.py
COPY packages/core /app/packages/core
COPY packages/backend /app/packages/backend

# Set environment variables
# Include both backend and core in PYTHONPATH to ensure modules are found
ENV PYTHONPATH=/app/packages/backend:/app/packages/core
ENV PYTHONUNBUFFERED=1

# Default command (will be overridden in docker-compose)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

