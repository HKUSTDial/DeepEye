# ==============================================
# DeepEye Configuration
# ==============================================
# 1. Copy this file to .env: `cp env.example .env`
# 2. Docker Compose will automatically read .env.
# ==============================================

# ----------------------------------------------
# 1. Host Port Mappings (Optional)
# ----------------------------------------------
# Exposed ports on localhost. Defaults are shown below.
HOST_FRONTEND_PORT=5173
HOST_BACKEND_PORT=8001

# ----------------------------------------------
# 2. LLM Provider Configuration (Required)
# ----------------------------------------------
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://vip.yi-zhan.top/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
