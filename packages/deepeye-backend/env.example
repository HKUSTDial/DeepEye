# Database
# PostgreSQL 配置（用于 docker-compose 和应用）
# 这些变量会被 docker-compose.yml 读取，应用也会使用它们自动构建 DATABASE_URL
POSTGRES_DB=deepeye
POSTGRES_USER=deepeye
POSTGRES_PASSWORD=deepeye
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 数据库连接 URL（应用使用，可选）
# 如果未设置，应用会自动从上面的 POSTGRES_* 变量构建
# 如果需要自定义连接字符串（如使用云数据库、SSL 等），可以手动设置
# DATABASE_URL=postgresql+asyncpg://deepeye:deepeye@localhost:5432/deepeye

# JWT
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=DeepEye API
VERSION=0.1.0
DEBUG=true

# CORS
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@deepeye.com
SMTP_TLS=true

# LLM (for deepeye-core)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Storage (Minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deepeye
MINIO_SECURE=False

# Logging
LOG_LEVEL=INFO

