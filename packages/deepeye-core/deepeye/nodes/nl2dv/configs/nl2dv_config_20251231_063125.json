    "width": 1280,
    "height": 720
  },
  "scenes": [
    {
      "id": "scene_opening",
      "type": "opening",
      "content": {
        "title": "Tech Industry Insights",
        "subtitle": "Revenue and Workforce Comparison"
      },
      "narration": [
        {
          "text": "Explore the revenue and workforce statistics of leading tech companies."
        }
      ]
    },
    {
      "id": "scene_chart_1",
      "type": "chart",
      "content": {
        "chart_type": "bar_chart",
        "title": "Revenue Comparison Among Major Tech Companies",
        "data": [
          {
            "company": "Apple",
            "revenue": 394.3,
            "employees": 164000
          },
          {
            "company": "Microsoft",
            "revenue": 211.9,
            "employees": 221000
          },
          {
            "company": "Google",
            "revenue": 307.4,
            "employees": 190234
          },
          {
            "company": "Amazon",
            "revenue": 514.0,
            "employees": 1541000
          },
          {
            "company": "Meta",
            "revenue": 134.9,
            "employees": 86482
          }
        ],
        "data_binding": {
          "x_axis": {
            "field": "company",
            "label": "Company"
          },
          "y_axis": {
            "field": "revenue",
            "label": "Revenue (Billion USD)"
          }
        },
        "style": {
          "bar_color": "#5b8ff9",
          "highlight_color": "#ff6b6b",
          "background_color": "#0f1419",
          "text_color": "#e8eaed",
          "grid_color": "#555555",
          "axis_color": "#888888"
        },
        "layout": {
          "margin": {
            "top": 80,
            "right": 60,
            "bottom": 100,
            "left": 100
          },
          "chart_area": {
            "width": 1120,
            "height": 540
          }
        }
      },
      "narration": [
        {
          "text": "Let's examine the revenue of major tech companies."
        },
        {
          "text": "Amazon leads with an impressive 514 billion dollars, far surpassing others."
        },
        {
          "text": "Apple follows in second place with 394.3 billion dollars."
        }
      ],
      "animations": [
        {
          "id": "entrance_anim",
          "type": "entrance",
          "effect": "grow_bars",
          "trigger_narration": 0,
          "description": "Chart entrance animation synced with overview"
        },
        {
          "id": "emphasis_amazon",
          "type": "emphasis",
          "effect": "pulse",
          "trigger_narration": 1,
          "target_data": {
            "data_filter": {
              "company": "Amazon"
            }
          },
          "style": {
            "intensity": 0.1
          },
          "description": "Highlight Amazon when mentioned"
        },
        {
          "id": "emphasis_apple",
          "type": "emphasis",
          "effect": "pulse",
          "trigger_narration": 2,
          "target_data": {
            "data_filter": {
              "company": "Apple"
            }
          },
          "style": {
            "intensity": 0.1
          },
          "description": "Highlight Apple when mentioned"
        }
      ]
